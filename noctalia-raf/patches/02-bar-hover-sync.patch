From 6f6811d361e399eac276e0ba0892fbcbdbd2a2b9 Mon Sep 17 00:00:00 2001
From: raf <raf@localhost>
Date: Thu, 12 Nov 2026 22:25:03 +0500
Subject: [PATCH] bar: resync pointer hover after layout

Bar widgets whose content moves or resizes under a resting pointer got no
enter/leave until the pointer moved. Run syncPointerHover after layout, as
panels, the dock, the switcher and plugin layers already do.
---
 src/shell/bar/bar.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/shell/bar/bar.cpp b/src/shell/bar/bar.cpp
index eac2b9692..b11d8fe44 100644
--- a/src/shell/bar/bar.cpp
+++ b/src/shell/bar/bar.cpp
@@ -3764,6 +3764,11 @@ void Bar::prepareFrame(BarInstance& instance, bool needsUpdate, bool needsLayout
     }
     layoutBarSections(instance, renderer, barAreaW, barAreaH, padding, isVertical);
   }
+  // Content that moved or resized under a resting pointer gets its enter/leave now, not on the
+  // next pointer motion (as panels, the dock and layers already do).
+  if (instance.pointerInside) {
+    instance.inputDispatcher.syncPointerHover();
+  }
   // Click-through input follows the widgets, which move whenever a widget resizes.
   if (instance.barConfig.deadZone.clickThrough) {
     syncBarAutoHideInputRegion(instance);
-- 
