# Maintainer: raf
# Noctalia built from an upstream release tag plus the local *.patch files
# next to this PKGBUILD (applied in name order). Based on Arch's extra/noctalia PKGBUILD.
# See docs/noctalia.md in noctalia-appmenu for the update workflow.

_pkgname=noctalia
pkgname=noctalia-raf
pkgver=5.6.0
pkgrel=1
pkgdesc='A sleek, customizable desktop shell crafted for Wayland (with local patches)'
arch=('x86_64')
url='https://github.com/noctalia-dev/noctalia'
license=('MIT')
provides=("noctalia=${pkgver}")
conflicts=('noctalia')
depends=(
  'bash' 'cairo' 'curl' 'fontconfig' 'freetype2' 'git' 'glib2' 'glibc' 'harfbuzz'
  'hicolor-icon-theme' 'jemalloc' 'libgcc' 'libglvnd' 'libical' 'libjxl' 'libpipewire'
  'libqalculate' 'librsvg' 'libsecret' 'libsndfile' 'libsodium' 'libstdc++' 'libwebp'
  'libwireplumber' 'libxkbcommon' 'libxml2' 'md4c' 'pam' 'polkit' 'pango' 'sdbus-cpp'
  'tomlplusplus' 'wayland'
)
optdepends=(
  'ddcutil: monitor brightness control'
  'power-profiles-daemon: power profile management'
  'upower: battery and power device integration'
)
makedepends=('meson' 'ninja' 'nlohmann-json' 'pkgconf' 'stb' 'wayland-protocols')

# Patches: keep this list in sync with the *.patch files here (makepkg needs each file
# listed to checksum it). Empty while running the plain upstream release.
_patches=(
  01-panel-reanchor.patch
)

source=("${_pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver//_/-}.tar.gz"
        "${_patches[@]}")
sha256sums=('c2f0fcc30bae289ecc39ab495ae68120c5882902371cde14f4f08b8bf14210a1'
            '41eaae48ed599a79b4cc8e20dae2faa93e3689f2288d2a9701457f9b8d625624')

prepare() {
  cd "${_pkgname}-${pkgver//_/-}"
  local p
  for p in "${_patches[@]}"; do
    echo "Applying ${p}"
    patch -Np1 -i "${srcdir}/${p}"
  done
}

build() {
  CXXFLAGS+=" -Wno-unused-result"
  arch-meson "${_pkgname}-${pkgver//_/-}" build-release \
    -Db_ndebug=true \
    -Dtests=disabled
  meson compile -C build-release
  for shell in bash fish zsh; do
    build-release/noctalia completions "$shell" > "${shell}-completion"
  done
}

package() {
  meson install -C build-release --destdir "${pkgdir}"

  install -Dm644 "${_pkgname}-${pkgver//_/-}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_pkgname}-${pkgver//_/-}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -vDm644 bash-completion "$pkgdir/usr/share/bash-completion/completions/noctalia"
  install -vDm644 fish-completion "$pkgdir/usr/share/fish/vendor_completions.d/noctalia.fish"
  install -vDm644 zsh-completion "$pkgdir/usr/share/zsh/site-functions/_noctalia"
}
